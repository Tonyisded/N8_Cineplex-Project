# Backend configuration: copy this file to .env ONLY if .env does not exist.
# Never commit .env or put real credentials in this example.

# HTTP listener. Use 0.0.0.0 only when deliberately exposing the service/container.
HOST=127.0.0.1
PORT=5000
# Enable only behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Off by default: scheduled crawling writes catalog data when enabled.
CRAWLER_ENABLED=false

# PostgreSQL: replace username/password/database; URL-encode special characters.
DATABASE_URL="postgresql://cineplex:CHANGE_ME@127.0.0.1:5432/n8_cineplex"

# Required: three DIFFERENT secrets, each at least 32 characters. Blank on purpose.
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Preserve existing secrets: rotating them invalidates tokens and signed quotes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# Required Gmail sender and a real 16-character App Password (not account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public HTTPS API origin for email links/avatars; must end with /api/v1.
# Replace this example hostname with your reachable, trusted HTTPS endpoint.
PUBLIC_BASE_URL=https://api.example.com/api/v1
# Required absolute writable directory on the API host; adapt for your OS/deployment.
# Windows example below; Linux example: /var/lib/n8-cineplex/avatars
AVATAR_UPLOAD_DIR="D:/NT118/N8_Cineplex-Project/backend/uploads/avatars"

# Optional: Google WEB OAuth client ID matching Android googleWebClientId.
# Empty disables Google sign-in on the backend. This is NOT an OAuth client secret.
GOOGLE_CLIENT_ID=

# Android does not load .env: see README.md for existing Gradle properties.
# No payment-provider keys yet: payOS/MB/Bao Kim integration is not implemented.

# Week 9: disabled until explicit live UAT. Credentials are server-only.
PAYMENT_LIVE_ENABLED=false
REFUND_PAYOUT_ENABLED=false
TRANSACTION_EMAIL_ENABLED=false
FCM_ENABLED=false
# Collection channel / MB receiving account (server verifies recipient)
PAYOS_COLLECT_CLIENT_ID=
PAYOS_COLLECT_API_KEY=
PAYOS_COLLECT_CHECKSUM_KEY=
# Physical linked bank account; signed per-order MB virtual accounts are stored on each intent.
PAYOS_COLLECT_ACCOUNT_NUMBER=
# Payout channel / funded Bao Kim source; allow the fixed proxy exit when proxy is enabled
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
# Independent local cryptographic keys. Generate securely; never commit real values.
TICKET_QR_SECRET=
PAYMENT_DATA_ENCRYPTION_KEY=
# Firebase server credentials; Android config does not contain private keys
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Android compatibility: raise minimum only after publishing the matching APK. Zero disables legacy blocking locally.
ANDROID_MIN_VERSION_CODE=0
ANDROID_LATEST_VERSION_CODE=7
# Absolute server-side read-only APK file path and its SHA256; no private signing key belongs here.
ANDROID_APK_PATH=
ANDROID_APK_SHA256=

# Fixed CONNECT proxy for payout-channel HTTPS only; never alternate IPs or disable TLS.
# Set private values in backend/.env. Use the approved crawler proxy endpoint/credentials.
PAYOS_PAYOUT_PROXY_ENABLED=false
PAYOS_PAYOUT_PROXY_SERVER=
PAYOS_PAYOUT_PROXY_USERNAME=
PAYOS_PAYOUT_PROXY_PASSWORD=
# New refunds: at most 4 send attempts, >=180s apart; read-only reconciliation continues after the send limit.
REFUND_RETRY_ENABLED=false
