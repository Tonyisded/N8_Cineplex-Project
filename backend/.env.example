# Backend configuration: copy this file to .env ONLY if .env does not exist.
# Never commit .env or put real credentials in this example.

# HTTP listener. Use 0.0.0.0 only when deliberately exposing the service/container.
HOST=127.0.0.1
PORT=5000
# Enable only behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Off by default: scheduled crawling writes catalog data when enabled.
CRAWLER_ENABLED=false

# PostgreSQL: replace username/password/database; URL-encode special characters.
DATABASE_URL="postgresql://cineplex:CHANGE_ME@127.0.0.1:5432/n8_cineplex"

# Required: three DIFFERENT secrets, each at least 32 characters. Blank on purpose.
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Preserve existing secrets: rotating them invalidates tokens and signed quotes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# Required Gmail sender and a real 16-character App Password (not account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public HTTPS API origin for email links/avatars; must end with /api/v1.
# Replace this example hostname with your reachable, trusted HTTPS endpoint.
PUBLIC_BASE_URL=https://api.example.com/api/v1
# Required absolute writable directory on the API host; adapt for your OS/deployment.
# Windows example below; Linux example: /var/lib/n8-cineplex/avatars
AVATAR_UPLOAD_DIR="D:/NT118/N8_Cineplex-Project/backend/uploads/avatars"

# Optional: Google WEB OAuth client ID matching Android googleWebClientId.
# Empty disables Google sign-in on the backend. This is NOT an OAuth client secret.
GOOGLE_CLIENT_ID=

# Android does not load .env: see README.md for existing Gradle properties.
# No payment-provider keys yet: payOS/MB/Bao Kim integration is not implemented.
